#!/bin/busybox sh
# FalloutOS - HTC One M7 stage-1 init
#
# Runs entirely from RAM. Mounts no block device and writes nothing to the
# eMMC. Provides a shell over USB (CDC-ACM serial and CDC-NCM network) and
# on tty1, and runs the hardware probe once.

/bin/busybox mkdir -p /bin /sbin /usr/bin /usr/sbin
/bin/busybox --install -s

mkdir -p /proc /sys /dev /tmp /run
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mount -t configfs configfs /sys/kernel/config 2>/dev/null
mkdir -p /sys/fs/pstore
mount -t pstore pstore /sys/fs/pstore 2>/dev/null

log() {
	echo "falloutos: $*" > /dev/kmsg
	echo "falloutos: $*"
}

log "stage 1 init on $(uname -r)"

# --- USB gadget: ACM (serial shell) + NCM (network) -----------------------
usb_gadget() {
	g=/sys/kernel/config/usb_gadget/falloutos
	udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	if [ -z "$udc" ]; then
		log "no USB device controller found"
		return 1
	fi

	mkdir -p "$g" || return 1
	# Same IDs as the postmarketOS/Nura initramfs, so host rules match.
	echo 0x18d1 > "$g/idVendor"
	echo 0xd001 > "$g/idProduct"
	mkdir -p "$g/strings/0x409"
	echo "FalloutOS" > "$g/strings/0x409/manufacturer"
	echo "HTC One M7 (stage 1)" > "$g/strings/0x409/product"
	echo "falloutos-htc-m7" > "$g/strings/0x409/serialnumber"

	mkdir -p "$g/functions/acm.usb0" "$g/functions/ncm.usb0"
	mkdir -p "$g/configs/c.1/strings/0x409"
	echo "acm+ncm" > "$g/configs/c.1/strings/0x409/configuration"
	ln -s "$g/functions/acm.usb0" "$g/configs/c.1/"
	ln -s "$g/functions/ncm.usb0" "$g/configs/c.1/"
	echo "$udc" > "$g/UDC" || return 1
	log "USB gadget bound to $udc"
}

usb_network() {
	i=0
	while [ $i -lt 50 ] && ! ip link show usb0 >/dev/null 2>&1; do
		sleep 0.1
		i=$((i + 1))
	done
	ip addr add 172.16.42.1/24 dev usb0 || return 1
	ip link set usb0 up
	udhcpd /etc/udhcpd.conf
	telnetd -b 172.16.42.1:23 -l /bin/sh
	log "USB network up: telnet 172.16.42.1"
}

# Respawning shell on a terminal device.
shell_on() {
	tty=$1
	(
		while true; do
			if [ -c "$tty" ]; then
				setsid -c sh -l <"$tty" >"$tty" 2>&1
			fi
			sleep 1
		done
	) &
}

usb_gadget && usb_network
shell_on /dev/ttyGS0
shell_on /dev/tty1

# --- Hardware probe (read-only) ---------------------------------------------
/usr/share/falloutos/m7-probe > /run/m7-probe.txt 2>&1
log "probe written to /run/m7-probe.txt"

# PID 1 must never exit.
while true; do
	sleep 3600
done
