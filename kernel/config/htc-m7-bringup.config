# FalloutOS: HTC One M7 bring-up fragment.
# Applied on top of pmaports device/testing/linux-postmarketos-qcom-apq8064/
# config-postmarketos-qcom-apq8064.armv7 (see sources.lock).

CONFIG_LOCALVERSION="-falloutos-htc-m7"

# USB gadget built in, so the bring-up initramfs needs no kernel modules
# (pmaports builds CONFIG_USB_CONFIGFS as a module).
CONFIG_USB_CONFIGFS=y

# Reproducible builds: no per-build random module signing key (its public
# half is embedded in vmlinux). SECURITY_LOCKDOWN_LSM selects MODULE_SIG;
# the base config sets LOCK_DOWN_KERNEL_FORCE_NONE, so lockdown was never
# active and dropping the LSM does not change behaviour.
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_MODULE_SIG is not set

# Stage 1 reads the MDP scan-out registers via /dev/mem (MMIO only).
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
